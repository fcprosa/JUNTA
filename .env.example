# true: localStorage + dados sintéticos, sem Supabase.
# false: beta real; nunca faz fallback silencioso para localStorage.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase beta (obrigatório quando o modo demo é false)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Segredo exclusivamente server-side. Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Acesso fechado, listas separadas por vírgulas
BETA_ALLOWED_EMAIL_DOMAINS=universidade.pt
MAX_BETA_USERS=100
ADMIN_EMAILS=admin@universidade.pt

# OpenAI-compatible opcional, apenas para estruturar planos.
# Sem estas variáveis é usado o parser local.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
